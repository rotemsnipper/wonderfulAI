{
  "version": 1,
  "notes": "Code-graded eval cases. 'figures' name keys in scripts/recompute/expected.json (dot path) and the tolerance in percent of the expected value. 'rules' map system-prompt rules to the cases that exercise them.",
  "cases": [
    {
      "id": "q1_new_england",
      "turns": [
        "Which airports in New England are strong candidates for terminal expansion?"
      ],
      "expected_airports": [
        "BGR",
        "PWM",
        "BOS"
      ],
      "required": [
        "(?i)score|rank",
        "(?i)robust|sensitive|weight",
        "(?i)partial|no delay data|HVN"
      ],
      "forbidden": [
        "(?i)\\bROI\\b"
      ],
      "number_check": true,
      "rules": [
        "R1",
        "R3",
        "R5"
      ]
    },
    {
      "id": "q2_lax_sna",
      "turns": [
        "Compare LA and Santa Ana airport congestion levels."
