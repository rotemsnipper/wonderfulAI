        "LAX",
        "SNA"
      ],
      "required": [
        "(?i)delay",
        "(?i)runway",
        "(?i)LA.*(LAX|Los Angeles International)|assum"
      ],
      "figures": [
        {
          "key": "q2.LAX.delay_rate_pct.value",
          "tolerance_pct": 2.5
        },
        {
          "key": "q2.SNA.delay_rate_pct.value",
          "tolerance_pct": 2.5
        }
      ],
      "number_check": true,
      "rules": [
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    {
